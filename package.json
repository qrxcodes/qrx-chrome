{
  "name": "qrx-chrome",
  "version": "1.0.0",
  "private": true,
  "description": "QRX browser extension for Chrome and Edge: make an artistic QR code for the page you're on.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:extension",
    "build:extension": "cross-env NODE_ENV=production QRX_ENV=prod vite build -c vite.config.extension.ts",
    "build:extension:dev": "cross-env NODE_ENV=production QRX_ENV=dev vite build -c vite.config.extension.ts",
    "dev:extension": "cross-env NODE_ENV=development QRX_ENV=dev vite build --watch -c vite.config.extension.ts",
    "zip": "tsx scripts/zip-extension.ts",
    "package": "npm run build:extension && npm run zip",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "store:assets": "tsx scripts/render-store-assets.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,html}\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^5.1.0",
    "archiver": "^7.0.1",
    "@types/archiver": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
