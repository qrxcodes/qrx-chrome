{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "types": ["chrome", "node"]
  },
  "include": ["extension/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
