{
  "manifest_version": 3,
  "name": "QRX: art QR codes that scan",
  "short_name": "QRX",
  "version": "1.0.0",
  "description": "Make an artistic QR code for the page you're on. Pick a style, describe a picture, and get a qrx.to short link.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "identity", "storage", "alarms", "notifications"],
  "host_permissions": [],
  "action": {
    "default_title": "Make a QR code for this page",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
